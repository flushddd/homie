#!/usr/bin/env python3
"""Keyboard teleop → /cmd_vel + /homie/height_cmd (pygame window, works under roslaunch).

Focus the small pygame window, then:
  w/s : forward / back
  a/d : left / right
  q/e : yaw left / right
  r/f : height up / down
  space : zero velocity
  esc   : quit node
"""

from __future__ import annotations

import sys

import rospy
from geometry_msgs.msg import Twist
from std_msgs.msg import Float64

try:
    import pygame
except ImportError as e:
    raise SystemExit("pygame required: pip install pygame\n" + str(e))


HELP = [
    "Homie keyboard teleop",
    "w/s  forward/back",
    "a/d  left/right",
    "q/e  yaw",
    "r/f  height",
    "space  stop",
    "esc  quit",
]


class KeyboardCmdNode:
    def __init__(self) -> None:
        self.rate_hz = float(rospy.get_param("~rate", 50.0))
        self.step_v = float(rospy.get_param("~step_v", 0.05))
        self.step_w = float(rospy.get_param("~step_w", 0.05))
        self.step_h = float(rospy.get_param("~step_h", 0.005))
        self.max_lin_x = float(rospy.get_param("~max_lin_x", 0.6))
        self.max_lin_y = float(rospy.get_param("~max_lin_y", 0.4))
        self.max_ang_z = float(rospy.get_param("~max_ang_z", 0.6))
        self.height = float(rospy.get_param("~height_cmd", 0.74))
        self.height_min = float(rospy.get_param("~height_min", 0.25))
        self.height_max = float(rospy.get_param("~height_max", 0.85))

        self.vx = 0.0
        self.vy = 0.0
        self.yaw = 0.0

        pygame.init()
        pygame.display.set_caption("Homie Keyboard Teleop (focus here)")
        self.screen = pygame.display.set_mode((360, 220))
        self.font = pygame.font.SysFont("dejavusans", 18)
        self.clock = pygame.time.Clock()

        self.vel_pub = rospy.Publisher("/cmd_vel", Twist, queue_size=1)
        self.h_pub = rospy.Publisher("/homie/height_cmd", Float64, queue_size=1)
        rospy.loginfo("keyboard teleop: focus the pygame window, then use WASD/QE/RF")

    def _clamp(self) -> None:
        self.vx = max(-self.max_lin_x, min(self.max_lin_x, self.vx))
        self.vy = max(-self.max_lin_y, min(self.max_lin_y, self.vy))
        self.yaw = max(-self.max_ang_z, min(self.max_ang_z, self.yaw))
        self.height = max(self.height_min, min(self.height_max, self.height))

    def _draw(self) -> None:
        self.screen.fill((24, 28, 36))
        lines = HELP + [
            "",
            f"vx={self.vx:+.2f}  vy={self.vy:+.2f}  yaw={self.yaw:+.2f}",
            f"height={self.height:.3f}",
        ]
        y = 12
        for line in lines:
            surf = self.font.render(line, True, (220, 220, 220))
            self.screen.blit(surf, (16, y))
            y += 22
        pygame.display.flip()

    def spin(self) -> None:
        while not rospy.is_shutdown():
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    rospy.signal_shutdown("window closed")
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:
                        rospy.signal_shutdown("esc")
                    elif event.key == pygame.K_SPACE:
                        self.vx = self.vy = self.yaw = 0.0

            keys = pygame.key.get_pressed()
            if keys[pygame.K_w]:
                self.vx += self.step_v
            if keys[pygame.K_s]:
                self.vx -= self.step_v
            if keys[pygame.K_a]:
                self.vy += self.step_v
            if keys[pygame.K_d]:
                self.vy -= self.step_v
            if keys[pygame.K_q]:
                self.yaw += self.step_w
            if keys[pygame.K_e]:
                self.yaw -= self.step_w
            if keys[pygame.K_r]:
                self.height += self.step_h
            if keys[pygame.K_f]:
                self.height -= self.step_h

            # mild decay when keys released so it settles
            if not (keys[pygame.K_w] or keys[pygame.K_s]):
                self.vx *= 0.85
                if abs(self.vx) < 0.01:
                    self.vx = 0.0
            if not (keys[pygame.K_a] or keys[pygame.K_d]):
                self.vy *= 0.85
                if abs(self.vy) < 0.01:
                    self.vy = 0.0
            if not (keys[pygame.K_q] or keys[pygame.K_e]):
                self.yaw *= 0.85
                if abs(self.yaw) < 0.01:
                    self.yaw = 0.0

            self._clamp()
            tw = Twist()
            tw.linear.x = self.vx
            tw.linear.y = self.vy
            tw.angular.z = self.yaw
            self.vel_pub.publish(tw)
            self.h_pub.publish(Float64(data=self.height))
            self._draw()
            self.clock.tick(self.rate_hz)


def main() -> None:
    rospy.init_node("homie_keyboard_cmd")
    try:
        node = KeyboardCmdNode()
        node.spin()
    except rospy.ROSInterruptException:
        pass
    finally:
        pygame.quit()


if __name__ == "__main__":
    main()
