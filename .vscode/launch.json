{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HomieRL mjlab: Train (1 env + Viser)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "HOMIE_TRAIN_VISER": "1",
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1",
        "--env.scene.num-envs",
        "1",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: Train (1 env)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1",
        "--env.scene.num-envs",
        "1",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: Train (4096)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1",
        "--env.scene.num-envs",
        "4096",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: Smoke Train (64)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1",
        "--env.scene.num-envs",
        "64",
        "--agent.max-iterations",
        "5",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: Train Phase2 (4096)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1-Phase2",
        "--env.scene.num-envs",
        "4096",
        "--agent.resume",
        "True",
        "--agent.load-run",
        "${input:homiePhase1Run}",
        "--agent.load-checkpoint",
        "${input:homiePhase1Ckpt}",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: Resume Phase1 (4096)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1",
        "--env.scene.num-envs",
        "4096",
        "--agent.resume",
        "True",
        "--agent.load-run",
        "${input:homieResumeRun}",
        "--agent.load-checkpoint",
        "${input:homieResumeCkpt}",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: Resume Phase2 (4096)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1-Phase2",
        "--env.scene.num-envs",
        "4096",
        "--agent.resume",
        "True",
        "--agent.load-run",
        "${input:homieResumePhase2Run}",
        "--agent.load-checkpoint",
        "${input:homieResumePhase2Ckpt}",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: TensorBoard",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "tensorboard.main",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}"
      },
      "args": [
        "--logdir",
        "logs/rsl_rl/homie_g1",
        "--port",
        "6007",
        "--bind_all"
      ]
    },
    {
      "name": "HomieRL mjlab: Play (Viser)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.play",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1",
        "--num-envs",
        "1",
        "--viewer",
        "viser",
        "--checkpoint-file",
        "${input:homieCheckpoint}"
      ]
    },
    {
      "name": "HomieRL mjlab: Play Phase2 (Viser)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.play",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1-Phase2",
        "--num-envs",
        "1",
        "--viewer",
        "viser",
        "--checkpoint-file",
        "${input:homiePhase2Checkpoint}"
      ]
    },
    {
      "name": "HomieRL mjlab: Train Phase3 (4096)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1-Phase3",
        "--env.scene.num-envs",
        "4096",
        "--agent.resume",
        "True",
        "--agent.load-run",
        "${input:homiePhase2RunForPhase3}",
        "--agent.load-checkpoint",
        "${input:homiePhase2CkptForPhase3}",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: Resume Phase3 (4096)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.train",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1-Phase3",
        "--env.scene.num-envs",
        "4096",
        "--agent.resume",
        "True",
        "--agent.load-run",
        "${input:homieResumePhase3Run}",
        "--agent.load-checkpoint",
        "${input:homieResumePhase3Ckpt}",
        "--agent.logger",
        "tensorboard",
        "--agent.upload-model",
        "False"
      ]
    },
    {
      "name": "HomieRL mjlab: Play Phase3 (Viser)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "module": "mjlab.scripts.play",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "Mjlab-Homie-Flat-Unitree-G1-Phase3",
        "--num-envs",
        "1",
        "--viewer",
        "viser",
        "--checkpoint-file",
        "${input:homiePhase3Checkpoint}"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage3 BPTT Checks",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage3_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "--check"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage3 BPTT Smoke (1 env)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage3_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "--stage2-checkpoint",
        "${input:homieStage2CkptForBptt}",
        "--num-envs",
        "1",
        "--device",
        "cuda:0",
        "--warmup-collect",
        "20",
        "--collect-per-iter",
        "10",
        "--iters",
        "2",
        "--save-every",
        "1",
        "--ee-mode",
        "attractor",
        "--log-dir",
        "logs/stage3_bptt_smoke"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage3 BPTT Train (16)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage3_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "--stage2-checkpoint",
        "${input:homieStage2CkptForBptt}",
        "--num-envs",
        "16",
        "--device",
        "cuda:0",
        "--warmup-collect",
        "200",
        "--collect-per-iter",
        "50",
        "--iters",
        "100",
        "--save-every",
        "10",
        "--ee-mode",
        "attractor",
        "--log-dir",
        "logs/stage3_bptt"
      ]
    }
  ],
  "compounds": [
    {
      "name": "HomieRL mjlab: Train + TensorBoard",
      "configurations": [
        "HomieRL mjlab: Train (4096)",
        "HomieRL mjlab: TensorBoard"
      ],
      "stopAll": true
    },
    {
      "name": "HomieRL mjlab: Resume Phase1 + TensorBoard",
      "configurations": [
        "HomieRL mjlab: Resume Phase1 (4096)",
        "HomieRL mjlab: TensorBoard"
      ],
      "stopAll": true
    },
    {
      "name": "HomieRL mjlab: Train Phase3 + TensorBoard",
      "configurations": [
        "HomieRL mjlab: Train Phase3 (4096)",
        "HomieRL mjlab: TensorBoard"
      ],
      "stopAll": true
    },
    {
      "name": "HomieRL mjlab: Stage3 BPTT Train + TensorBoard",
      "configurations": [
        "HomieRL mjlab: Stage3 BPTT Train (16)",
        "HomieRL mjlab: TensorBoard"
      ],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "homieCheckpoint",
      "type": "promptString",
      "description": "Path to checkpoint (e.g. logs/rsl_rl/homie_g1/<run>/model_200.pt)",
      "default": "logs/rsl_rl/homie_g1/"
    },
    {
      "id": "homiePhase1Run",
      "type": "promptString",
      "description": "Phase-1 run folder name under logs/rsl_rl/homie_g1/",
      "default": "2026-10-10_16-30-36"
    },
    {
      "id": "homiePhase1Ckpt",
      "type": "promptString",
      "description": "Phase-1 checkpoint filename",
      "default": "model_11000.pt"
    },
    {
      "id": "homieResumeRun",
      "type": "promptString",
      "description": "Phase-1 run folder to resume (under logs/rsl_rl/homie_g1/)",
      "default": "2026-10-10_16-30-36"
    },
    {
      "id": "homieResumeCkpt",
      "type": "promptString",
      "description": "Checkpoint to resume (prefer pre-crash, e.g. model_9000.pt)",
      "default": "model_9000.pt"
    },
    {
      "id": "homieResumePhase2Run",
      "type": "promptString",
      "description": "Phase-2 run folder to resume (under logs/rsl_rl/homie_g1/)",
      "default": "2026-10-11_17-12-56_phase2"
    },
    {
      "id": "homieResumePhase2Ckpt",
      "type": "promptString",
      "description": "Phase-2 checkpoint filename",
      "default": "model_18800.pt"
    },
    {
      "id": "homiePhase2Checkpoint",
      "type": "promptString",
      "description": "Phase-2 checkpoint path (e.g. logs/rsl_rl/homie_g1/<run>_phase2/model_*.pt)",
      "default": "logs/rsl_rl/homie_g1/phase2/model_17400.pt"
    },
    {
      "id": "homiePhase2RunForPhase3",
      "type": "promptString",
      "description": "Phase-2 run folder to load as Phase-3 teacher (under logs/rsl_rl/homie_g1/)",
      "default": "phase2"
    },
    {
      "id": "homiePhase2CkptForPhase3",
      "type": "promptString",
      "description": "Phase-2 checkpoint filename for Phase-3 resume",
      "default": "model_17400.pt"
    },
    {
      "id": "homieResumePhase3Run",
      "type": "promptString",
      "description": "Phase-3 run folder to resume (under logs/rsl_rl/homie_g1/)",
      "default": "phase3"
    },
    {
      "id": "homieResumePhase3Ckpt",
      "type": "promptString",
      "description": "Phase-3 checkpoint filename",
      "default": "model_0.pt"
    },
    {
      "id": "homiePhase3Checkpoint",
      "type": "promptString",
      "description": "Phase-3 checkpoint path (e.g. logs/rsl_rl/homie_g1/<run>_phase3/model_*.pt)",
      "default": "logs/rsl_rl/homie_g1/"
    },
    {
      "id": "homieStage2CkptForBptt",
      "type": "promptString",
      "description": "Frozen phase-2 checkpoint for Stage3 BPTT (full path under HomieRL_mjlab/)",
      "default": "logs/rsl_rl/homie_g1/phase2/model_15400(2).pt"
    }
  ]
}
