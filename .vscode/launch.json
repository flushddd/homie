{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "HomieRL mjlab: Play Stage3 BPTT (Viser)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/play_stage3_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "--stage2-checkpoint",
        "${input:homieStage2CkptForBptt}",
        "--bptt-checkpoint",
        "${input:homieBpttCheckpoint}",
        "--curriculum",
        "A",
        "--ee-mode",
        "actor",
        "--device",
        "cuda:0",
        "--log-every",
        "25"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage3 BPTT Checks",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage3_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "--check"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage3 BPTT Smoke (1 env)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage3_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "--stage2-checkpoint",
        "${input:homieStage2CkptForBptt}",
        "--num-envs",
        "1",
        "--device",
        "cuda:0",
        "--curriculum",
        "A",
        "--curriculum-auto",
        "--start-phase",
        "body",
        "--warmup-collect",
        "20",
        "--collect-per-iter",
        "10",
        "--iters",
        "2",
        "--save-every",
        "1",
        "--ee-mode",
        "actor",
        "--control-mode",
        "body_ee_palm_delta",
        "--log-dir",
        "logs/rsl_rl/homie_g1",
        "--run-name",
        "stage3_bptt_smoke"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage3 BPTT Train (16)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage3_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "--stage2-checkpoint",
        "${input:homieStage2CkptForBptt}",
        "--num-envs",
        "16",
        "--device",
        "cuda:0",
        "--curriculum",
        "A",
        "--curriculum-auto",
        "--start-phase",
        "body",
        "--warmup-collect",
        "1000",
        "--collect-per-iter",
        "200",
        "--iters",
        "100000",
        "--save-every",
        "500",
        "--ee-mode",
        "actor",
        "--control-mode",
        "body_ee_palm_delta",
        "--log-dir",
        "logs/rsl_rl/homie_g1",
        "--run-name",
        "stage3_bptt"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage3 BPTT Train (4096)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/HomieRL_mjlab/.venv/bin/python",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage3_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "VIRTUAL_ENV": "${workspaceFolder}/HomieRL_mjlab/.venv",
        "PATH": "${workspaceFolder}/HomieRL_mjlab/.venv/bin:${env:PATH}",
        "PYTHONPATH": "${workspaceFolder}/HomieRL_mjlab/src${pathSeparator}${env:PYTHONPATH}"
      },
      "args": [
        "--stage2-checkpoint",
        "${input:homieStage2CkptForBptt}",
        "--num-envs",
        "4096",
        "--device",
        "cuda:0",
        "--curriculum",
        "A",
        "--curriculum-auto",
        "--start-phase",
        "body",
        "--warmup-collect",
        "1000",
        "--collect-per-iter",
        "32",
        "--iters",
        "100000",
        "--save-every",
        "200",
        "--ee-mode",
        "actor",
        "--control-mode",
        "body_ee_palm_delta",
        "--log-dir",
        "logs/rsl_rl/homie_g1",
        "--run-name",
        "stage3_bptt"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage12 BPTT Checks",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage12_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--check"
      ]
    },
    {
      "name": "HomieRL mjlab: Stage12 BPTT Phase1 (4096)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/HomieRL_mjlab/scripts/train_stage12_bptt.py",
      "cwd": "${workspaceFolder}/HomieRL_mjlab",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--phase",
        "1",
        "--num_envs",
        "4096",
        "--collect_steps",
        "50",
        "--device",
        "cuda:0"
      ]
    }
  ],
  "inputs": [
    {
      "id": "homiePhase1Ckpt",
      "type": "promptString",
      "description": "Phase-1 checkpoint filename",
      "default": "model_11000.pt"
    },
    {
      "id": "homieResumeCkpt",
      "type": "promptString",
      "description": "Checkpoint to resume (prefer pre-crash, e.g. model_9000.pt)",
      "default": "model_9000.pt"
    },
    {
      "id": "homieResumePhase2Ckpt",
      "type": "promptString",
      "description": "Phase-2 checkpoint filename",
      "default": "model_18800.pt"
    },
    {
      "id": "homiePhase2CkptForPhase3",
      "type": "promptString",
      "description": "Phase-2 checkpoint filename for Phase-3 resume",
      "default": "model_17400.pt"
    },
    {
      "id": "homieResumePhase3Ckpt",
      "type": "promptString",
      "description": "Phase-3 checkpoint filename",
      "default": "model_0.pt"
    },
    {
      "id": "homieStage2CkptForBptt",
      "type": "promptString",
      "description": "Frozen phase-2 checkpoint for Stage3 BPTT (full path under HomieRL_mjlab/)",
      "default": "logs/rsl_rl/homie_g1/phase2/model_18600.pt"
    },
    {
      "id": "homieBpttCheckpoint",
      "type": "promptString",
      "description": "Stage3 BPTT actor ckpt (train_stage3_bptt model_*.pt; has key 'actor')",
      "default": "logs/rsl_rl/homie_g1/phase3/model_9400.pt"
    }
  ]
}
